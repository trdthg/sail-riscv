    .insn 4, (0x0a00102b | ((\md) << 7) | ((\ms1) << 15))
.endm
# mrowzip.ew md, ms1, ms2
.macro mrowzip.ew md, ms1, ms2
    .insn 4, (0x3600002b | ((\md) << 7) | ((\ms1) << 15) | ((\ms2) << 20))
.endm
