  // if (src1_nregs == 0) {
  //   src1_nregs = 1;
  // }
  // U32 src1_elements_per_reg = AME_NELEM / src1_nregs;
  //
  // U32 src2_element_size = ame_dtype_val_to_size(src2_dtype);
  // U32 src2_nregs = src2_element_size / AME_UNIT_DATATYPE_SIZE;
  // if (src2_nregs == 0) {
  //   src2_nregs = 1;
  // }
  // U32 src2_elements_per_reg = AME_NELEM / src2_nregs;
  //
  // U32 dest_element_size = ame_dtype_val_to_size(dest_dtype);
  // U32 dest_nregs = dest_element_size / AME_UNIT_DATATYPE_SIZE;
  // if (dest_nregs == 0) {
  //   dest_nregs = 1;
  // }
  // U32 dest_elements_per_reg = AME_NELEM / dest_nregs;
  //
  // ####################################################################################
  // ## Check for exceptions
  // ####################################################################################
  //
  // if (!ame_op_supported(AmeOperation::ROWZIP1D, dest_dtype, src1_dtype, src2_dtype)) {
  //   raise(ExceptionCode::IllegalInstruction, mode(), $encoding);
  // }
  //
  // if (AME_NUM_M_REGS == 16) {
  //   if (ms1 >= 16 || ms2 >= 16 || md >= 16) {
  //     raise(ExceptionCode::IllegalInstruction, mode(), $encoding);
  //   }
  // }
  //
  // if ((ms1 % src1_nregs) != 0) {
  //   raise(ExceptionCode::IllegalInstruction, mode(), $encoding);
  // }
  // if ((ms2 % src2_nregs) != 0) {
  //   raise(ExceptionCode::IllegalInstruction, mode(), $encoding);
  // }
  // # md must be even-aligned for the implicit register pair
  // if ((md % 2) != 0) {
  //   raise(ExceptionCode::IllegalInstruction, mode(), $encoding);
  // }
  // if ((md % dest_nregs) != 0) {
  //   raise(ExceptionCode::IllegalInstruction, mode(), $encoding);
  // }
  //
  // ####################################################################################
  // ## Perform the row zip
  // ## The destination pair (md, md+1) represents 2N rows:
  // ##   md    covers output rows 0..N-1
  // ##   md+1  covers output rows N..2N-1
  // ## Even output rows come from ms1; odd output rows come from ms2.
  // ####################################################################################
  //
  // U32 N = sqrt(AME_NELEM);
  //
  // for (U32 k = 0; k < N; k++) {   # source row index (0..N-1)
  //   for (U32 j = 0; j < N; j++) { # column index
  //     U32 e_src = k * N + j;
  //
  //     # ms1[k,j] -> output row 2k, column j
  //     U32 out_row_even = 2 * k;
  //     U32 out_reg_even = out_row_even / N;   # 0 or 1 (selects md or md+1)
  //     U32 out_local_even = out_row_even % N;
  //     U32 e_dst_even = out_local_even * N + j;
  //
  //     U32 src1_regno = e_src / src1_elements_per_reg;
  //     U32 src1_hi = ((e_src + 1) * src1_element_size) - (src1_regno * AME_MATRIX_REGISTER_SIZE);
  //     U32 src1_lo = ((e_src + 1) * src1_element_size) - (src1_regno * AME_MATRIX_REGISTER_SIZE);
  //
  //     U32 dst_even_regno = e_dst_even / dest_elements_per_reg;
  //     U32 dst_even_hi = ((e_dst_even + 1) * dest_element_size) - (dst_even_regno * AME_MATRIX_REGISTER_SIZE);
  //     U32 dst_even_lo = ((e_dst_even + 1) * dest_element_size) - (dst_even_regno * AME_MATRIX_REGISTER_SIZE);
  //
  //     M[md + out_reg_even + dst_even_regno][dst_even_hi:dst_even_lo] =
  //       ame_xform_rm_to_impl(ame_op(AmeOperation::ROWZIP1D, src1_dtype, ame_xform_impl_to_rm(M[ms1 + src1_regno], src1_dtype)[src1_hi:src1_lo],
  //              src1_dtype, ame_xform_impl_to_rm(M[ms1 + src1_regno], src1_dtype)[src1_hi:src1_lo], dest_dtype), dest_dtype);
  //
  //     # ms2[k,j] -> output row 2k+1, column j
  //     U32 out_row_odd = 2 * k + 1;
  //     U32 out_reg_odd = out_row_odd / N;
  //     U32 out_local_odd = out_row_odd % N;
  //     U32 e_dst_odd = out_local_odd * N + j;
  //
  //     U32 src2_regno = e_src / src2_elements_per_reg;
  //     U32 src2_hi = ((e_src + 1) * src2_element_size) - (src2_regno * AME_MATRIX_REGISTER_SIZE);
  //     U32 src2_lo = ((e_src + 1) * src2_element_size) - (src2_regno * AME_MATRIX_REGISTER_SIZE);
  //
  //     U32 dst_odd_regno = e_dst_odd / dest_elements_per_reg;
  //     U32 dst_odd_hi = ((e_dst_odd + 1) * dest_element_size) - (dst_odd_regno * AME_MATRIX_REGISTER_SIZE);
  //     U32 dst_odd_lo = ((e_dst_odd + 1) * dest_element_size) - (dst_odd_regno * AME_MATRIX_REGISTER_SIZE);
  //
  //     M[md + out_reg_odd + dst_odd_regno][dst_odd_hi:dst_odd_lo] =
  //       ame_xform_rm_to_impl(ame_op(AmeOperation::ROWZIP1D, src2_dtype, ame_xform_impl_to_rm(M[ms2 + src2_regno], src2_dtype)[src2_hi:src2_lo],
  //              src2_dtype, ame_xform_impl_to_rm(M[ms2 + src2_regno], src2_dtype)[src2_hi:src2_lo], dest_dtype), dest_dtype);
  //   }
  // }
  // }
  internal_error(__FILE__, __LINE__, "Zvame execute stub: mrowzip.ew")
}

