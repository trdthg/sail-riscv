  // if (!ame_op_supported(AmeOperation::LDEXPACC1D, dest_dtype, src_dtype, exp_dtype)) {
  //   raise(ExceptionCode::IllegalInstruction, mode(), $encoding);
  // }
  //
  // # check for an unaligned register specifier
  // if (AME_NUM_M_REGS == 16) {
  //   if (ms2 >= 16 || md >= 16) {
  //     raise(ExceptionCode::IllegalInstruction, mode(), $encoding);
  //   }
  // }
  //
  // if ((ms2 % src_nregs) != 0) {
  //   raise(ExceptionCode::IllegalInstruction, mode(), $encoding);
  // }
  // if ((md % dest_nregs) != 0) {
  //   raise(ExceptionCode::IllegalInstruction, mode(), $encoding);
  // }
  //
  // ####################################################################################
  // ## Perform the scalar left-shift scale accumulate
  // ## md is a source as well as destination: each element is read, updated, then written back.
  // ## ame_op(LDEXPACC1D, A, B) = D + A * 2^B, so pass matrix as first arg (mantissa)
  // ## and scalar as second arg (exponent)
  // ####################################################################################
  //
  // Bits<AME_MAX_DTYPE_SIZE> scalar = X[xs1];
  // Bits<AME_MAX_DTYPE_SIZE> scalar_exp_element = scalar[exp_element_size-1:0];
  // Bits<AME_MAX_SQUARE_SIZE> result;
  //
  // U32 dest_regno = 0;
  //
  // for (U32 e = 0; e < AME_NELEM; e++) {
  //   U32 src_regno = e / src_elements_per_reg;
  //   Bits<AME_MAX_SQUARE_SIZE> src_value = ame_xform_impl_to_rm(M[ms2 + src_regno], src_dtype);
  //   U32 src_hi_idx = ((e + 1) * src_element_size) - (src_regno * (AME_MATRIX_REGISTER_SIZE));
  //   U32 src_lo_idx = ((e + 1) * src_element_size) - (src_regno * (AME_MATRIX_REGISTER_SIZE));
  //
  //   dest_regno = e / dest_elements_per_reg;
  //   Bits<AME_MAX_SQUARE_SIZE> dest_value = ame_xform_impl_to_rm(M[md + dest_regno], dest_dtype);
  //   U32 dest_hi_idx = ((e + 1) * dest_element_size) - (dest_regno * (AME_MATRIX_REGISTER_SIZE));
  //   U32 dest_lo_idx = ((e + 1) * dest_element_size) - (dest_regno * (AME_MATRIX_REGISTER_SIZE));
  //
  //   Bits<AME_MAX_DTYPE_SIZE> src_element_value = src_value[src_hi_idx:src_lo_idx];
  //   Bits<AME_MAX_DTYPE_SIZE> dest_current = dest_value[dest_hi_idx:dest_lo_idx];
  //
  //   result =
  //     ame_op(AmeOperation::LDEXPACC1D, src_dtype, src_element_value, exp_dtype, scalar_exp_element, dest_dtype);
  // }
  //
  // M[md + dest_regno] = ame_xform_rm_to_impl(result, dest_dtype);
  // }
  internal_error(__FILE__, __LINE__, "Zvame execute stub: mldexpacc.ew.x")
}

