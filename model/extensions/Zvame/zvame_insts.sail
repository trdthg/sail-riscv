// *****************************************************************
// mmulacc.2d: acc, ms1, ms2
union clause instruction = AME_MMULACC_2D : (bits(2), bits(5), bits(5))

mapping clause encdec = AME_MMULACC_2D(acc, ms1, ms2)
  <-> 0b0000001 @ ms2 : bits(5) @ ms1 : bits(5) @ 0b01000 @ acc : bits(2) @ 0b00101011
  when currentlyEnabled(Ext_Zvame)

function clause execute AME_MMULACC_2D(acc, ms1, ms2) = {
  // TODO: implement mmulacc.2d semantics.
  // UDB operation():
  // Bits<32> dest_dtype = Ad[acc];
  // Bits<32> src1_dtype = Md[ms1];
  // Bits<32> src2_dtype = Md[ms2];
  //
  // if (!ame_op_supported(AmeOperation::MMACC1D, dest_dtype, src1_dtype, src2_dtype)) {
  //   CSR[amestatus].UN = 1;
  // } else if (ame_dtype_is_storage_only(dest_dtype) ||
  //     ame_dtype_is_storage_only(src1_dtype) ||
  //     ame_dtype_is_storage_only(src2_dtype)) {
  //   CSR[amestatus].UN = 1;
  // } else {
  //
  //
  // ####################################################################################
  // ## Calculate element/register sizes for each register index
  // ####################################################################################
  //
  // U32 src1_element_size = ame_dtype_val_to_size(src1_dtype);
  // U32 src1_nregs = src1_element_size / AME_UNIT_DATATYPE_SIZE;
  // if (src1_nregs == 0) {
  //   src1_nregs = 1;
  // }
  // U32 src1_elements_per_reg = AME_NELEM / src1_nregs;
  //
  // U32 src2_element_size = ame_dtype_val_to_size(src2_dtype);
  // U32 src2_nregs = src2_element_size / AME_UNIT_DATATYPE_SIZE;
  // if (src2_nregs == 0) {
  //   src2_nregs = 1;
  // }
  // U32 src2_elements_per_reg = AME_NELEM / src2_nregs;
  //
  // U32 dest_element_size = ame_dtype_val_to_size(dest_dtype);
  //
  // ####################################################################################
  // ## Check for exceptions
  // ####################################################################################
  //
  // if (!ame_op_supported(AmeOperation::MMACC1D, dest_dtype, src1_dtype, src2_dtype)) {
  //   raise(ExceptionCode::IllegalInstruction, mode(), $encoding);
  // }
  //
  // if (AME_NUM_M_REGS == 16) {
  //   if (ms1 >= 16 || ms2 >= 16) {
  //     raise(ExceptionCode::IllegalInstruction, mode(), $encoding);
  //   }
  // }
  //
  // if ((ms1 % src1_nregs) != 0) {
  //   raise(ExceptionCode::IllegalInstruction, mode(), $encoding);
  // }
  // if ((ms2 % src2_nregs) != 0) {
  //   raise(ExceptionCode::IllegalInstruction, mode(), $encoding);
  // }
  // ####################################################################################
  // ## acc[i,k] += sum_j ms1[i,j] * ms2[j,k]
  // ## acc is a source as well as destination: each output element is read before updating.
  // ####################################################################################
  //
  // U32 N = sqrt(AME_NELEM);
  //
  // for (U32 i = 0; i < N; i++) {
  //   for (U32 k = 0; k < N; k++) {
  //     U32 e_d = i * N + k;
  //     U32 d_hi = ((e_d + 1) * dest_element_size);
  //     U32 d_lo = ((e_d + 1) * dest_element_size);
  //
  //     Bits<AME_MAX_DTYPE_SIZE> sum = ame_xform_impl_to_rm(Acc[acc], dest_dtype)[d_hi:d_lo];
  //
  //     for (U32 j = 0; j < N; j++) {
  //       U32 e_a = i * N + j;
  //       U32 a_regno = e_a / src1_elements_per_reg;
  //       U32 a_hi = ((e_a + 1) * src1_element_size) - (a_regno * AME_MATRIX_REGISTER_SIZE);
  //       U32 a_lo = ((e_a + 1) * src1_element_size) - (a_regno * AME_MATRIX_REGISTER_SIZE);
  //
  //       U32 e_b = j * N + k;
  //       U32 b_regno = e_b / src2_elements_per_reg;
  //       U32 b_hi = ((e_b + 1) * src2_element_size) - (b_regno * AME_MATRIX_REGISTER_SIZE);
  //       U32 b_lo = ((e_b + 1) * src2_element_size) - (b_regno * AME_MATRIX_REGISTER_SIZE);
  //
  //       sum = sum + ame_op(AmeOperation::MMACC1D, src1_dtype, ame_xform_impl_to_rm(M[ms1 + a_regno], src1_dtype)[a_hi:a_lo],
  //                    src2_dtype, ame_xform_impl_to_rm(M[ms2 + b_regno], src2_dtype)[b_hi:b_lo], dest_dtype);
  //     }
  //
  //     Acc[acc][d_hi:d_lo] = ame_xform_rm_to_impl(sum, dest_dtype);
  //   }
  // }
  // }
  let dest_dtype : bits(32) = AD(Ameadregidx(acc));
  let src1_dtype : bits(32) = MD(Mdregidx(ms1));
  let src2_dtype : bits(32) = MD(Mdregidx(ms2));
  if ame_mmulacc_2d(dest_dtype, src1_dtype, src2_dtype, Ameaccregidx(acc), Ameregidx(ms1), Ameregidx(ms2)) then
    RETIRE_SUCCESS
  else
    Illegal_Instruction()
}

