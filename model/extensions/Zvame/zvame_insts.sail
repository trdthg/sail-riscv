  //   if (ms1 >= 16) {
  //     raise(ExceptionCode::IllegalInstruction, mode(), $encoding);
  //   }
  // }
  //
  // X[xd] = Md[ms1];
  X(Regidx(trunc(xd))) = zero_extend(MD(Mdregidx(ms1)));
  RETIRE_SUCCESS
}

