  //   U32 src1_lo_idx = ((e + 1) * src1_element_size) - (src1_regno * (AME_MATRIX_REGISTER_SIZE));
  //
  //   U32 src2_regno = e / src2_elements_per_reg;
  //   Bits<AME_MAX_SQUARE_SIZE> src2_value = ame_xform_impl_to_rm(M[ms2 + src2_regno], src2_dtype);
  //   U32 src2_hi_idx = ((e + 1) * src2_element_size) - (src2_regno * (AME_MATRIX_REGISTER_SIZE));
  //   U32 src2_lo_idx = ((e + 1) * src2_element_size) - (src2_regno * (AME_MATRIX_REGISTER_SIZE));
  //
  //   dest_regno = e / dest_elements_per_reg;
  //   U32 dest_hi_idx = ((e + 1) * dest_element_size) - (dest_regno * (AME_MATRIX_REGISTER_SIZE));
  //   U32 dest_lo_idx = ((e + 1) * dest_element_size) - (dest_regno * (AME_MATRIX_REGISTER_SIZE));
  //
  //   Bits<AME_MAX_DTYPE_SIZE> src1_element_value = src1_value[src1_hi_idx:src1_lo_idx];
  //   Bits<AME_MAX_DTYPE_SIZE> src2_element_value = src2_value[src2_hi_idx:src2_lo_idx];
  //
  //   result =
  //     ame_op(AmeOperation::MIN1D, src1_dtype, src1_element_value, src2_dtype, src2_element_value, dest_dtype);
  // }
  //
  // M[md + dest_regno] = ame_xform_rm_to_impl(result, dest_dtype);
  // }
  internal_error(__FILE__, __LINE__, "Zvame execute stub: mmin.ew")
}

