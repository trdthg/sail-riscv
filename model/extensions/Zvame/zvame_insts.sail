// *****************************************************************
// msettyp: md, xs1
union clause instruction = AME_MSETTYP : (bits(5), bits(5))

mapping clause encdec = AME_MSETTYP(md, xs1)
  <-> 0b000000100000 @ xs1 : bits(5) @ 0b101 @ md : bits(5) @ 0b0101011
  when currentlyEnabled(Ext_Zvame)

function clause execute AME_MSETTYP(md, xs1) = {
  // TODO: implement msettyp semantics.
  // UDB operation():
  // Bits<32> dtype = X[xs1][31:0];
  //
  // if (AME_NUM_M_REGS == 16) {
  //   if (md >= 16) {
  //     raise(ExceptionCode::IllegalInstruction, mode(), $encoding);
  //   }
  // }
  //
  // if (!ame_datatype_supported(dtype)) {
  //   CSR[amestatus].UN = 1;
  // } else {
  //   Md[md] = X[xs1];
  //   M[md] = 0;
  // }
  let dtype : bits(32) = X(Regidx(trunc(xs1)))[31..0];
  let size = ame_dtype_size(dtype);
  if size == 0 then return Illegal_Instruction();
  let nregs = ame_nregs(size);
  if not(ame_check_mreg_group_operand(md, nregs)) then return Illegal_Instruction();
  MD(Mdregidx(md)) = dtype;
  let max_regs = acclen / mlen;
  foreach (r from 0 to (max_regs - 1)) {
    if r < nregs then M(ameregidx_add(Ameregidx(md), r)) = zeros()
  };
  RETIRE_SUCCESS
}

