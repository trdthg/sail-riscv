  //       U32 src_hi = ((e_src + 1) * src1_element_size) - ($signed(src_regno) * AME_MATRIX_REGISTER_SIZE);
  //       U32 src_lo = ((e_src + 1) * src1_element_size) - ($signed(src_regno) * AME_MATRIX_REGISTER_SIZE);
  //
  //       Bits<AME_MAX_DTYPE_SIZE> src_value = ame_xform_impl_to_rm(M[ms1 + src_regno], src1_dtype)[src_hi:src_lo];
  //
  //       M[md + dst_regno][dst_hi:dst_lo] =
