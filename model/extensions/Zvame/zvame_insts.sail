}

// *****************************************************************
// mss: ms1, xs1
union clause instruction = AME_MSS : (bits(5), bits(5))

mapping clause encdec = AME_MSS(ms1, xs1)
  <-> 0b000010100000 @ xs1 : bits(5) @ 0b011 @ ms1 : bits(5) @ 0b0101011
  when currentlyEnabled(Ext_Zvame)

function clause execute AME_MSS(ms1, xs1) = {
  // TODO: implement mss semantics.
  // UDB operation():
  // XReg address = X[xs1];
  //
  // if (AME_NUM_M_REGS == 16) {
  //   if (ms1 >= 16) {
  //     raise(ExceptionCode::IllegalInstruction, mode(), $encoding);
  //   }
  // }
  //
  // XReg impl_size_bytes = AME_MAX_SQUARE_SIZE >> 3;
  //
  // XReg alignment = min(impl_size_bytes, 4096);
  //
  // if (address % alignment != 0) {
  //   # unaligned store
  //   raise(ExceptionCode::StoreAmoAddressMisaligned, mode(), $encoding);
  // }
  //
  // write_memory_ame(address, $encoding, M[ms1], impl_size_bytes);
  let dtype : bits(32) = MD(Mdregidx(ms1));
  if ame_dtype_size(dtype) == 0 then return Illegal_Instruction();
  let nregs = ame_nregs(ame_dtype_size(dtype));
  if not(ame_check_mreg_group_operand(ms1, nregs)) then return Illegal_Instruction();
  let byte_count = ame_mreg_group_bytes(dtype);
  if unsigned(X(Regidx(trunc(xs1)))) % max(1, byte_count) != 0 then
    return memory_exception(Virtaddr(X(Regidx(trunc(xs1)))), E_SAMO_Addr_Align());
  ame_store_mreg_group_raw(Ameregidx(ms1), Regidx(trunc(xs1)), nregs)
}

// *****************************************************************
// mss.cm: ms1, xs1
union clause instruction = AME_MSS_CM : (bits(5), bits(5))

mapping clause encdec = AME_MSS_CM(ms1, xs1)
  <-> 0b000010000000 @ xs1 : bits(5) @ 0b011 @ ms1 : bits(5) @ 0b0101011
  when currentlyEnabled(Ext_Zvame)

function clause execute AME_MSS_CM(ms1, xs1) = {
  // TODO: implement mss.cm semantics.
  // UDB operation():
  // XReg address = X[xs1];
  // Bits<32> dtype = Md[ms1];
  //
  // if (AME_NUM_M_REGS == 16) {
  //   if (ms1 >= 16) {
  //     raise(ExceptionCode::IllegalInstruction, mode(), $encoding);
  //   }
  // }
  //
  // U32 element_size_bits = ame_dtype_val_to_size(dtype);
  // U32 element_size_bytes = element_size_bits >> 3;
  // U32 pack_factor = ame_dtype_is_storage_only(dtype)
  //   ? (AME_UNIT_DATATYPE_SIZE / element_size_bits)
  //   : 1;
  //
  // XReg total_bytes = pack_factor * AME_NELEM * element_size_bytes;
  // XReg alignment = min(total_bytes, 4096);
  //
  // if (address % alignment != 0) {
  //   raise(ExceptionCode::StoreAmoAddressMisaligned, mode(), $encoding);
  // }
  //
  // Bits<AME_MAX_SQUARE_SIZE> tmp = ame_xform_impl_to_cm(M[ms1], dtype);
  //
  // for (U32 sq = 0; sq < pack_factor; sq++) {
  //   for (U32 j = 0; j < sqrt(AME_NELEM); j++) {
  //     for (U32 i = 0; i < sqrt(AME_NELEM); i++) {
  //       U32 element_idx = sq * AME_NELEM + j * sqrt(AME_NELEM) + i;
  //       U32 bit_lo = element_idx * element_size_bits;
  //       U32 bit_hi = bit_lo + element_size_bits - 1;
  //       write_memory_ame(address + element_idx * element_size_bytes, $encoding,
  //         tmp[bit_hi:bit_lo], element_size_bytes);
  //     }
  //   }
  // }
  internal_error(__FILE__, __LINE__, "Zvame execute stub: mss.cm")
}

