  // ####################################################################################
  // ## Check for exceptions
  // ####################################################################################
  //
  // # check datatype support
  // if (!ame_op_supported(AmeOperation::MUL1D, dest_dtype, src_dtype, src_dtype)) {
  //   raise(ExceptionCode::IllegalInstruction, mode(), $encoding);
  // }
  //
  // # check for an unaligned register specifier
  // if (AME_NUM_M_REGS == 16) {
  //   if (ms2 >= 16 || md >= 16) {
  //     raise(ExceptionCode::IllegalInstruction, mode(), $encoding);
  //   }
  // }
  //
  // if ((ms2 % src_nregs) != 0) {
  //   raise(ExceptionCode::IllegalInstruction, mode(), $encoding);
  // }
  // if ((md % dest_nregs) != 0) {
  //   raise(ExceptionCode::IllegalInstruction, mode(), $encoding);
  // }
