// *****************************************************************
// mrowunzip.ew: md, ms1
union clause instruction = AME_MROWUNZIP_EW : (bits(5), bits(5))

mapping clause encdec = AME_MROWUNZIP_EW(md, ms1)
  <-> 0b000010100000 @ ms1 : bits(5) @ 0b001 @ md : bits(5) @ 0b0101011
  when currentlyEnabled(Ext_Zvame)

function clause execute AME_MROWUNZIP_EW(md, ms1) = {
  // TODO: implement mrowunzip.ew semantics.
  // UDB operation():
  // Bits<32> dest_dtype = Md[md];
  // Bits<32> src1_dtype = Md[ms1];
  //
  // if (!ame_op_supported(AmeOperation::ROWUNZIP1D, dest_dtype, src1_dtype, src1_dtype)) {
  //   CSR[amestatus].UN = 1;
  // } else if (ame_dtype_is_storage_only(dest_dtype) ||
  //     ame_dtype_is_storage_only(src1_dtype)) {
  //   CSR[amestatus].UN = 1;
  // } else {
  //
  //
  // ####################################################################################
  // ## Calculate element/register sizes
  // ####################################################################################
  //
  // U32 src1_element_size = ame_dtype_val_to_size(src1_dtype);
  // U32 src1_nregs = src1_element_size / AME_UNIT_DATATYPE_SIZE;
  // if (src1_nregs == 0) {
  //   src1_nregs = 1;
  // }
  // U32 src1_elements_per_reg = AME_NELEM / src1_nregs;
  //
  // U32 dest_element_size = ame_dtype_val_to_size(dest_dtype);
  // U32 dest_nregs = dest_element_size / AME_UNIT_DATATYPE_SIZE;
  // if (dest_nregs == 0) {
  //   dest_nregs = 1;
  // }
  // U32 dest_elements_per_reg = AME_NELEM / dest_nregs;
  //
  // ####################################################################################
  // ## Check for exceptions
  // ####################################################################################
  //
  // if (!ame_op_supported(AmeOperation::ROWUNZIP1D, dest_dtype, src1_dtype, src1_dtype)) {
  //   raise(ExceptionCode::IllegalInstruction, mode(), $encoding);
  // }
  //
  // if (AME_NUM_M_REGS == 16) {
  //   if (ms1 >= 16 || md >= 16) {
  //     raise(ExceptionCode::IllegalInstruction, mode(), $encoding);
  //   }
  // }
  //
  // if ((ms1 % src1_nregs) != 0) {
  //   raise(ExceptionCode::IllegalInstruction, mode(), $encoding);
  // }
  // # md must be even-aligned for the implicit register pair
  // if ((md % 2) != 0) {
  //   raise(ExceptionCode::IllegalInstruction, mode(), $encoding);
  // }
  // if ((md % dest_nregs) != 0) {
  //   raise(ExceptionCode::IllegalInstruction, mode(), $encoding);
  // }
  //
  // ####################################################################################
  // ## Perform the row unzip
  // ## Source ms1 is treated as a 2N-row matrix spanning (ms1, ms1+1).
  // ## Even source rows -> md; odd source rows -> md+1.
  // ####################################################################################
  //
  // U32 N = sqrt(AME_NELEM);
  //
  // for (U32 k = 0; k < N; k++) {   # output row index (0..N-1)
  //   for (U32 j = 0; j < N; j++) { # column index
  //     U32 e_dst = k * N + j;
  //
  //     # Even source row 2k -> md[k,j]
  //     U32 src_row_even = 2 * k;
  //     U32 src_reg_even = src_row_even / N;    # 0 or 1 (ms1 or ms1+1)
  //     U32 src_local_even = src_row_even % N;
  //     U32 e_src_even = src_local_even * N + j;
  //
  //     U32 src_even_regno = e_src_even / src1_elements_per_reg;
  //     U32 src_even_hi = ((e_src_even + 1) * src1_element_size) - (src_even_regno * AME_MATRIX_REGISTER_SIZE);
  //     U32 src_even_lo = ((e_src_even + 1) * src1_element_size) - (src_even_regno * AME_MATRIX_REGISTER_SIZE);
  //
  //     U32 dst_md_regno = e_dst / dest_elements_per_reg;
  //     U32 dst_md_hi = ((e_dst + 1) * dest_element_size) - (dst_md_regno * AME_MATRIX_REGISTER_SIZE);
  //     U32 dst_md_lo = ((e_dst + 1) * dest_element_size) - (dst_md_regno * AME_MATRIX_REGISTER_SIZE);
  //
  //     M[md + dst_md_regno][dst_md_hi:dst_md_lo] =
  //       ame_xform_rm_to_impl(ame_op(AmeOperation::ROWUNZIP1D, src1_dtype, ame_xform_impl_to_rm(M[ms1 + src_reg_even + src_even_regno], src1_dtype)[src_even_hi:src_even_lo],
  //              src1_dtype, ame_xform_impl_to_rm(M[ms1 + src_reg_even + src_even_regno], src1_dtype)[src_even_hi:src_even_lo], dest_dtype), dest_dtype);
  //
  //     # Odd source row 2k+1 -> (md+1)[k,j]
  //     U32 src_row_odd = 2 * k + 1;
  //     U32 src_reg_odd = src_row_odd / N;
  //     U32 src_local_odd = src_row_odd % N;
  //     U32 e_src_odd = src_local_odd * N + j;
  //
  //     U32 src_odd_regno = e_src_odd / src1_elements_per_reg;
  //     U32 src_odd_hi = ((e_src_odd + 1) * src1_element_size) - (src_odd_regno * AME_MATRIX_REGISTER_SIZE);
  //     U32 src_odd_lo = ((e_src_odd + 1) * src1_element_size) - (src_odd_regno * AME_MATRIX_REGISTER_SIZE);
  //
  //     U32 dst_md1_regno = e_dst / dest_elements_per_reg;
  //     U32 dst_md1_hi = ((e_dst + 1) * dest_element_size) - (dst_md1_regno * AME_MATRIX_REGISTER_SIZE);
  //     U32 dst_md1_lo = ((e_dst + 1) * dest_element_size) - (dst_md1_regno * AME_MATRIX_REGISTER_SIZE);
  //
  //     M[(md + 1) + dst_md1_regno][dst_md1_hi:dst_md1_lo] =
  //       ame_xform_rm_to_impl(ame_op(AmeOperation::ROWUNZIP1D, src1_dtype, ame_xform_impl_to_rm(M[ms1 + src_reg_odd + src_odd_regno], src1_dtype)[src_odd_hi:src_odd_lo],
  //              src1_dtype, ame_xform_impl_to_rm(M[ms1 + src_reg_odd + src_odd_regno], src1_dtype)[src_odd_hi:src_odd_lo], dest_dtype), dest_dtype);
  //   }
  // }
  // }
  internal_error(__FILE__, __LINE__, "Zvame execute stub: mrowunzip.ew")
}

