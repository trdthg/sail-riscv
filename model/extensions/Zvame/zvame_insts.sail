  // U32 dest_nregs = dest_element_size / AME_UNIT_DATATYPE_SIZE;
  // if (dest_nregs == 0) {
  //   # when the element size is less than AME_UNIT_DATATYPE_SIZE, we use a single register
  //   # (and have unused bits)
  //   dest_nregs = 1;
  // }
  // U32 dest_elements_per_reg = AME_NELEM / dest_nregs;
  //
  // ####################################################################################
  // ## Check for exceptions
  // ####################################################################################
  //
  // # check datatype support
  // if (!ame_op_supported(AmeOperation::SUB1D, dest_dtype, src_dtype, src_dtype)) {
  //   raise(ExceptionCode::IllegalInstruction, mode(), $encoding);
  // }
  //
