// *****************************************************************
// mmov.a.m: md, acc
union clause instruction = AME_MMOV_A_M : (bits(5), bits(2))

mapping clause encdec = AME_MMOV_A_M(md, acc)
  <-> 0b0000011000 @ acc : bits(2) @ 0b00000100 @ md : bits(5) @ 0b0101011
  when currentlyEnabled(Ext_Zvame)

function clause execute AME_MMOV_A_M(md, acc) = {
  // TODO: implement mmov.a.m semantics.
  // UDB operation():
  // Bits<32> dest_dtype = Md[md];
  // Bits<32> src_dtype = Ad[acc];
  //
  // if (dest_dtype[7:0] != src_dtype[7:0]) {
  //   CSR[amestatus].UN = 1;
  // } else {
  //
  // if (AME_NUM_M_REGS == 16) {
  //   if (md >= 16) {
  //     raise(ExceptionCode::IllegalInstruction, mode(), $encoding);
  //   }
  // }
  //
  // U32 element_size_bits = ame_dtype_val_to_size(dest_dtype);
  //
  // if (element_size_bits == 0) {
  //   CSR[amestatus].UN = 1;
  // } else {
  //
  // U32 dest_nregs = element_size_bits / AME_UNIT_DATATYPE_SIZE;
  // if (dest_nregs == 0) {
  //   dest_nregs = 1;
  // }
  // U32 elements_per_reg = AME_NELEM / dest_nregs;
  //
  // if ((md % dest_nregs) != 0) {
  //   raise(ExceptionCode::IllegalInstruction, mode(), $encoding);
  // }
  //
  // ####################################################################################
  // ## Copy AME_NELEM elements from acc (flat layout) to the destination M register group.
  // ## Elements in acc are indexed 0..AME_NELEM-1 at positions e*element_size_bits.
  // ####################################################################################
  //
  // for (U32 dest_regno = 0; dest_regno < dest_nregs; dest_regno++) {
  //   Bits<AME_MAX_SQUARE_SIZE> result = 0;
  //
  //   for (U32 local_e = 0; local_e < elements_per_reg; local_e++) {
  //     U32 e = dest_regno * elements_per_reg + local_e;
  //
  //     U32 acc_bit_lo = e * element_size_bits;
  //     U32 acc_bit_hi = acc_bit_lo + element_size_bits - 1;
  //
  //     U32 reg_bit_lo = local_e * element_size_bits;
  //     U32 reg_bit_hi = reg_bit_lo + element_size_bits - 1;
  //
  //     result[reg_bit_hi:reg_bit_lo] = ame_xform_impl_to_rm(Acc[acc], src_dtype)[acc_bit_hi:acc_bit_lo];
  //   }
  //
  //   M[md + dest_regno] = ame_xform_rm_to_impl(result, dest_dtype);
  // }
  // }
  // }
  let dest_dtype : bits(32) = MD(Mdregidx(md));
  let src_dtype : bits(32) = AD(Ameadregidx(acc));
  let dest_size = ame_dtype_size(dest_dtype);
  let src_size = ame_dtype_size(src_dtype);
  if dest_size == 0 | src_size == 0 | dest_size != src_size then return Illegal_Instruction();
  let dest_nregs = ame_nregs(dest_size);
  if not(ame_check_mreg_group_operand(md, dest_nregs)) then return Illegal_Instruction();
  write_m_square_rm(dest_dtype, Ameregidx(md), ACC(Ameaccregidx(acc)));
  RETIRE_SUCCESS
}

