  //   Bits<AME_MAX_SQUARE_SIZE> src_value = ame_xform_impl_to_rm(M[ms2 + src_regno], src_dtype);
  //   U32 src_hi_idx = ((e + 1) * src_element_size) - (src_regno * (AME_MATRIX_REGISTER_SIZE));
  //   U32 src_lo_idx = ((e + 1) * src_element_size) - (src_regno * (AME_MATRIX_REGISTER_SIZE));
  //
  //   dest_regno = e / dest_elements_per_reg;
  //   U32 dest_hi_idx = ((e + 1) * dest_element_size) - (dest_regno * (AME_MATRIX_REGISTER_SIZE));
  //   U32 dest_lo_idx = ((e + 1) * dest_element_size) - (dest_regno * (AME_MATRIX_REGISTER_SIZE));
